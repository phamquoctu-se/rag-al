# ============================================
# SmartShrimp RAG Service - Environment
# ============================================

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=1.0.0

# Internal API Key (shared voi smartshrimp_be)
INTERNAL_API_KEY=your-strong-internal-secret-key

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_LLM_MODEL=gemini-3.6-flash

# PostgreSQL + pgvector (dung chung Supabase voi smartshrimp_be)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# RAG Settings
SIMILARITY_THRESHOLD=0.5
TOP_K_DEFAULT=5
CHUNKING_STRATEGY=semantic
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SEMANTIC_BREAKPOINT_PERCENTILE=90
MIN_CHUNK_SIZE=350
MAX_CHUNK_SIZE=1200

# Logging
LOG_LEVEL=DEBUG
